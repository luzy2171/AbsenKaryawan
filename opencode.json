{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "naraya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaraRouter",
      "options": {
        "baseURL": "https://router.bynara.id/v1",
        "apiKey": "{env:NARAYA_API_KEY}"
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "agnes-2.5-flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "agnes-2.5-flash"
}